server {
  listen 80 default_server;
  listen [::]:80 default_server;

  root /usr/share/nginx/html;

  index index.html;

  server_name localhost;

  # Necessário pra resolver host quando o alvo do proxy_pass é uma
  # variável (target dinâmico vindo do query param). RESOLVER_IP é
  # extraído do /etc/resolv.conf do container em runtime (ver
  # nginx/resolver.envsh) pra usar o mesmo DNS que a rede docker/k8s já
  # fornece, em vez de fixar um nameserver que pode não enxergar hosts
  # internos.
  resolver ${RESOLVER_IP} valid=30s ipv6=off;

  location / {
    try_files $uri $uri/ @rewrites;
  }

  client_max_body_size 100M;

  location /uptime {
    # Backend é escolhido em runtime pelo client (painel /settings), via
    # ?target=. Só encaminha se o host bater no allowlist abaixo — sem
    # isso o nginx vira open proxy pra qualquer host (SSRF).
    if ($arg_target !~* "^https?://([a-zA-Z0-9-]+\.)*db1\.com\.br(:[0-9]+)?/?$|^https?://10\.200\.10\.(?:[0-9]|[1-9][0-9]|1[0-9]{2}|2[0-4][0-9]|25[0-5])(:[0-9]+)?/?$") {
      return 403 'target not allowed';
    }

    set $backend $arg_target;

    rewrite ^/uptime(.*)$ $1 break;  # Remove o prefixo /uptime
    # proxy_pass com variável ignora o rewrite acima e reenvia a URI
    # original do client ($request_uri) pro backend. Precisa concatenar
    # $uri explicitamente pra usar o path já reescrito.
    proxy_pass $backend$uri;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header Authorization $http_authorization;
    proxy_http_version 1.1;
  }

  location = /health {
    access_log off;
    add_header 'Content-Type' 'application/json';
    return 200 '{"status":"UP"}';
  }

  location @rewrites {
    rewrite ^(.+)$ / last;
  }
}
